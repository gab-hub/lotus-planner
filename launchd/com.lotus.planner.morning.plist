<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.lotus.planner.morning</string>
  <!-- 5am daily. If the Mac is asleep, launchd runs it as soon as it wakes. -->
  <key>ProgramArguments</key><array><string>__DIR__/bin/lotus-run</string><string>reset</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>0</integer></dict>
</dict></plist>
